{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AeroLog: ejecutar aplicación",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "AeroLog: pruebas de la API",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
